{
  "name": "deckbuilding",
  "private": true,
  "version": "0.1.0",
  "description": "API-first MTG deck-building platform with card inventory and AI (MCP) deck optimization.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @deck/db run migrate",
    "db:generate": "pnpm --filter @deck/db run generate",
    "db:seed": "pnpm --filter @deck/db run seed",
    "scryfall:import": "pnpm --filter @deck/scryfall run import",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
