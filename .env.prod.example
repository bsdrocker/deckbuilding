# Copy to .env.prod and fill in. Consumed by docker-compose.prod.yml.
# Generate secrets with e.g.:  openssl rand -hex 32

# --- Postgres ---
POSTGRES_USER=deck
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=deckbuilding

# --- App secrets ---
APP_SECRET=change-me-long-random
AUTH_SECRET=change-me-long-random

# --- Public URLs ---
# The HTTPS origin testers hit via your reverse proxy. Used for CORS.
PUBLIC_WEB_ORIGIN=https://qa.example.com
# Host port the web app is published on; your reverse proxy forwards here.
WEB_PORT=3000
# Host port the API is published on, for a reverse-proxy route to /v1 (used by
# the MCP HTTP backend). Keep firewalled — only the reverse proxy should reach it.
API_PORT_HOST=3001
# Optional: a public URL for the API's Swagger docs. Leave blank to hide the
# "API docs" nav link (the API is internal by default).
PUBLIC_API_DOCS_URL=
