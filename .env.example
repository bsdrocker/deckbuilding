# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://deck:deck@localhost:5432/deckbuilding?schema=public"

# API server
API_PORT=3001
API_HOST="0.0.0.0"
# Comma-separated origins allowed for CORS (web app dev server, etc.)
CORS_ORIGINS="http://localhost:3000"

# Secret used to sign/hash things that are not user passwords (e.g. session tokens later).
APP_SECRET="change-me-in-production"

# MCP server -> talks to the same DB in-process; it authenticates as a user via an API key.
DECKBUILDER_API_KEY=""

# Web app
NEXT_PUBLIC_API_URL="http://localhost:3001"
AUTH_SECRET="change-me-too"
